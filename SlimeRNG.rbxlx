				<Item class="LocalScript" referent="RBXD995DC7C9D464D5F99C06389D34AA723">
					<Properties>
						<ProtectedString name="Source"><![CDATA[-- ClientMain.client.lua
-- Bootstrap: initializes all client controllers in order
-- DO NOT add gameplay logic here

local PlayerScripts   = game:GetService("Players").LocalPlayer
    :WaitForChild("PlayerScripts")
local Controllers     = script.Parent.Controllers
local UIControllers   = script.Parent.UIControllers

local INIT_ORDER = {
    -- Input first — other controllers may depend on it
    { Controllers,   "InputController"   },
    -- Core controllers
    { Controllers,   "RollController"    },
    { Controllers,   "InventoryController" },
    { Controllers,   "FollowerController" },
    { Controllers,   "BiomeController"   },
    { Controllers,   "QuestController"   },
    { Controllers,   "PrestigeController" },
    -- UI last — depends on controller state
    { UIControllers, "HUDController"     },
    { UIControllers, "RollUIController"  },
    { UIControllers, "InventoryUIController" },
    { UIControllers, "NotificationController" },
    { UIControllers, "LeaderboardUIController" },
    { UIControllers, "BiomeUIController" },
    { UIControllers, "QuestUIController" },
    { UIControllers, "PrestigeUIController" },
}

local function init()
    for _, entry in ipairs(INIT_ORDER) do
        local folder, name = entry[1], entry[2]
        local ok, err = pcall(function()
            require(folder[name]).init()
        end)
        if not ok then
            warn(string.format("[ClientMain] Failed to init %s: %s", name, err))
        end
    end
    print("[ClientMain] All controllers initialized. Client ready.")
end

init()]]></ProtectedString>

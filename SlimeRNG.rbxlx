		<Item class="Folder" referent="RBX5E4C3D8A7FEA4EBD9EB4EC4250F2791C">
			<Properties>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">Core</string>
				<int64 name="SourceAssetId">-1</int64>
				<BinaryString name="Tags"></BinaryString>
				<UniqueId name="UniqueId">1f4ffcd29010124a09fb7048000008ae</UniqueId>
			</Properties>
			<Item class="Script" referent="RBXB67600B3CEDF4BB1BD1B37D33A21A9EC">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- GameManager.server.lua
-- Bootstrap: initializes all server services in dependency order
-- DO NOT add gameplay logic here

local ServerScriptService = game:GetService("ServerScriptService")
local Players             = game:GetService("Players")

local Services = ServerScriptService.Services
local Managers = ServerScriptService.Managers

-- ── Initialization Order ─────────────────────────────────
-- Ordered from lowest dependency to highest
local INIT_ORDER = {
    -- Tier 0: Foundation
    { Managers, "DataManager"    },
    { Managers, "SessionManager" },
    { Managers, "SecurityManager"},
    { Managers, "EventManager"   },
    -- Tier 1: Core Loop (MVP)
    { Services, "InventoryService" },
    { Services, "FollowerService"  },
    { Services, "RollService"      },
    { Services, "LeaderboardService" },
    -- Tier 2: Content (post-MVP stubs)
    { Services, "BiomeService"    },
    { Services, "QuestService"    },
    { Services, "PrestigeService" },
}

-- ── Player Lifecycle ─────────────────────────────────────
local function onPlayerAdded(player: Player)
    -- Each service handles its own player init via EventManager
    -- or direct call — implemented per service
end

local function onPlayerRemoving(player: Player)
    -- Each service handles its own player cleanup
end

-- ── Bootstrap ────────────────────────────────────────────
local function init()
    -- 1. Initialize all services in order
    for _, entry in ipairs(INIT_ORDER) do
        local folder, name = entry[1], entry[2]
        local ok, err = pcall(function()
            require(folder[name]).init()
        end)
        if not ok then
            warn(string.format("[GameManager] Failed to init %s: %s", name, err))
        end
    end

    -- 2. Wire player events AFTER all services are ready
    Players.PlayerAdded:Connect(onPlayerAdded)
    Players.PlayerRemoving:Connect(onPlayerRemoving)

    -- 3. Handle players who joined during initialization window
    for _, player in ipairs(Players:GetPlayers()) do
        task.spawn(onPlayerAdded, player)
    end

    print("[GameManager] All services initialized. Server ready.")
end

init()

]]></ProtectedString>
